# Токен бота MAX (платформа / «MAX для бизнеса» → Получить токен)
BOT_TOKEN=

# Приём фото на сервере optical
PHOTO_INBOX_URL=https://ostroeclub.ru/api/photo-inbox
PHOTO_INBOX_TOKEN=

# Рабочий чат (по умолчанию тот же в коде). Узнать id: /chatid. Все чаты: ALLOWED_CHAT_IDS=*
ALLOWED_CHAT_IDS=-73114090287804

# Ответ текстом при успехе (по умолчанию выкл.). Ошибки всегда реплаем.
REPLY_ON_SUCCESS=0
SHOW_IDS_IN_REPLY=0
# ERROR_REPLY_TEXT=ошибка, загрузка не удалась.

# Старый PHOTO_INBOX_URL с base.401010.ru бот сам меняет на ostroeclub.ru.
HTTP_TIMEOUT_SEC=120
HTTP_CONNECT_TIMEOUT_SEC=15
HTTP_RETRY_COUNT=3
HTTP_RETRY_BACKOFF_SEC=2
HEALTH_CHECK_SEC=300
POLL_TIMEOUT_SEC=30
POLL_LIMIT=100

# SSL: бандл Минцифры в certs/ подхватывается сам.
# SSL_VERIFY=0          # отключить проверку (если Bothost всё равно ругается)
# SSL_CA_BUNDLE=        # путь к своему .pem
# MAX_API_BASE=https://platform-api2.max.ru
